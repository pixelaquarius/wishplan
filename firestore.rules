rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(value, limit) { return value == null || (value is string && value.size() <= limit); }
    function metric(value) { return value == null || value is number; }
    function ranged(value, minimum, maximum) { return value == null || (value is number && value >= minimum && value <= maximum); }
    function flag(value) { return value == null || value is bool; }
    function items(value) { return value is list && value.size() <= 100; }
    function validSnapshot(d, id) {
      return d.keys().hasAll(['snapshotId', 'handle', 'savedAtIso', 'scorePct'])
        && d.keys().hasOnly([
          'snapshotId', 'handle', 'savedAtIso', 'savedAtFormatted', 'scorePct',
          'fileName', 'avatarUrl', 'mcnDisplay', 'isIndependent', 'firstPubDate',
          'dateRangeWindow', 'dataTimeText', 'bioText', 'isFemaleMajority', 'ageGroup',
          'followersCount', 'products30dCount', 'totalGmv', 'dailyGmv', 'liveGmv',
          'videoGmv', 'showcaseGmv', 'aov', 'liveViews', 'videoViews', 'followerChange',
          'videoCount30d', 'gmvPer1kFollowers', 'gmvPerVideo', 'viewsPerVideo',
          'videoSharePct', 'liveSharePct', 'dominantTrack', 'avgRoas', 'stores', 'videos',
          'products', 'top20MatchedBrands', 'specialistSkincareStores', 'personalCareStores',
          'apparelStores', 'skincareRevenue', 'personalCareRevenue', 'apparelRevenue',
          'maxSkincareOrdersOnSingleStore', 'skincareSkuCount', 'personalCareSkuCount',
          'apparelSkuCount', 'detectedIndustry', 'isCategoryAlignedWithSkincare'
        ])
        && d.snapshotId is string && d.snapshotId == id && id.size() <= 200
        && d.handle is string && d.handle.size() > 0 && d.handle.size() <= 120
        && d.savedAtIso is string
        && d.savedAtIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && ranged(d.get('scorePct', null), 0, 100)
        && text(d.get('savedAtFormatted', null), 120) && text(d.get('fileName', null), 256)
        && text(d.get('avatarUrl', null), 2048) && text(d.get('mcnDisplay', null), 256)
        && text(d.get('firstPubDate', null), 120) && text(d.get('dateRangeWindow', null), 256)
        && text(d.get('dataTimeText', null), 256) && text(d.get('bioText', null), 4096)
        && text(d.get('ageGroup', null), 64) && text(d.get('detectedIndustry', null), 256)
        && (!( 'dominantTrack' in d) || d.dominantTrack == null || d.dominantTrack in ['VIDEO_TRACK', 'LIVE_TRACK'])
        && flag(d.get('isIndependent', null)) && flag(d.get('isFemaleMajority', null)) && flag(d.get('isCategoryAlignedWithSkincare', null))
        && ranged(d.get('followersCount', null), 0, 1000000000000000) && metric(d.get('products30dCount', null))
        && metric(d.get('totalGmv', null)) && metric(d.get('dailyGmv', null))
        && metric(d.get('liveGmv', null)) && metric(d.get('videoGmv', null))
        && metric(d.get('showcaseGmv', null)) && metric(d.get('aov', null))
        && metric(d.get('liveViews', null)) && metric(d.get('videoViews', null))
        && ranged(d.get('followerChange', null), -1000000000000000, 1000000000000000) && metric(d.get('videoCount30d', null))
        && metric(d.get('gmvPer1kFollowers', null)) && metric(d.get('gmvPerVideo', null))
        && metric(d.get('viewsPerVideo', null)) && ranged(d.get('videoSharePct', null), 0, 100)
        && ranged(d.get('liveSharePct', null), 0, 100) && metric(d.get('avgRoas', null))
        && metric(d.get('specialistSkincareStores', null)) && metric(d.get('personalCareStores', null))
        && metric(d.get('apparelStores', null)) && metric(d.get('skincareRevenue', null))
        && metric(d.get('personalCareRevenue', null)) && metric(d.get('apparelRevenue', null))
        && metric(d.get('maxSkincareOrdersOnSingleStore', null)) && metric(d.get('skincareSkuCount', null))
        && metric(d.get('personalCareSkuCount', null)) && metric(d.get('apparelSkuCount', null))
        && items(d.get('stores', [])) && items(d.get('videos', [])) && items(d.get('products', [])) && items(d.get('top20MatchedBrands', []));
    }
    function validTombstone(d, id) {
      return d.keys().hasAll(['snapshotId', 'deleted', 'deletedAt'])
        && d.keys().hasOnly(['snapshotId', 'deleted', 'deletedAt'])
        && d.snapshotId == id && id.size() <= 200
        && d.deleted == true && d.deletedAt is string
        && d.deletedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }
    match /users/{uid}/snapshots/{snapshotId} {
      allow read: if owner(uid);
      allow delete: if owner(uid) && resource.data.get('deleted', false) != true;
      allow create: if owner(uid) && (validTombstone(request.resource.data, snapshotId) || validSnapshot(request.resource.data, snapshotId));
      allow update: if owner(uid) && (validTombstone(request.resource.data, snapshotId)
        || (resource.data.get('deleted', false) != true && validSnapshot(request.resource.data, snapshotId)));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
