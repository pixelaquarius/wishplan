{
  "name": "wishplan",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "workspaces": ["functions"],
  "overrides": { "@grpc/grpc-js": "1.14.7" },
  "scripts": {
    "test": "node --test tests/*.test.*",
    "test:firebase": "firebase emulators:exec --project demo-wishplan --only firestore,database \"node --test tests/firebase-rules.test.cjs\"",
    "test:ci": "npm test && npm run test:firebase"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0"
  }
}
